#!/bin/sh
set -eu

# The host-side GITHUB_TOKEN_FILE variable selects the Compose source file.
# Inside the container, the secret contract is always this mounted path.
secret_file=/run/secrets/github_token
if [ -r "$secret_file" ]; then
    token="$(cat -- "$secret_file")"
    if [ -n "$token" ]; then
        # Keep Git credential lookup on the runtime-mounted secret and prevent
        # any persisted credential.helper (including credential-store) from
        # being used. Existing credentials remain untouched when no secret is
        # mounted. The command-level empty helper entry resets system, global,
        # and repository helpers without hiding unrelated global settings such
        # as the configured commit identity.
        export GIT_CONFIG_NOSYSTEM=1
        export GIT_CONFIG_COUNT=2
        export GIT_CONFIG_KEY_0=credential.helper
        export GIT_CONFIG_VALUE_0=
        export GIT_CONFIG_KEY_1=credential.helper
        export GIT_CONFIG_VALUE_1=/usr/local/bin/git-credential-secret

        # gh gives GH_TOKEN precedence over its on-disk hosts.yml.
        export GH_TOKEN="$token"
    fi
fi

exec "$@"
