#!/bin/sh
set -eu

operation="${1:-}"
case "$operation" in
    get) ;;
    store|erase) exit 0 ;;
    *) exit 0 ;;
esac

host=""
while IFS='=' read -r key value; do
    case "$key" in
        host) host="$value" ;;
    esac
done

# Never offer a GitHub token to an unrelated host.
[ "$host" = "github.com" ] || exit 0

# The token is always consumed from the runtime-mounted secret path.
secret_file=/run/secrets/github_token
[ -r "$secret_file" ] || exit 0

token="$(cat -- "$secret_file")"
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n\n' "$token"
