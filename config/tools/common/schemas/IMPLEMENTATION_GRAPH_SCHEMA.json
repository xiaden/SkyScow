{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyscow.dev/schemas/implementation-graph.json",
  "title": "SkyScow Implementation Graph",
  "type": "object",
  "required": ["schema_version", "graph_id", "title", "source", "requirements", "contracts", "nodes", "final_qa"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "graph_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source": {"type": "object", "required": ["request_context"], "properties": {"request_context": {"type": "string"}, "design_doc": {"type": ["string", "null"]}}, "additionalProperties": true},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "text", "source"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "source": {"type": "string"}}, "additionalProperties": true}},
    "contracts": {"type": "array", "items": {"type": "object", "required": ["id", "description", "producer", "consumers"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "producer": {"type": ["string", "null"]}, "consumers": {"type": "array", "items": {"type": "string"}}, "actual": {"type": ["string", "object", "null"]}}, "additionalProperties": true}},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "title", "obligation", "depends_on", "status"], "properties": {"id": {"type": "string", "pattern": "^I[0-9]+$"}, "title": {"type": "string"}, "obligation": {"type": "string"}, "depends_on": {"type": "array", "items": {"type": "string"}}, "satisfies": {"type": "array", "items": {"type": "string"}}, "acceptance": {"type": "array", "items": {"type": "string"}}, "consumes": {"type": "array", "items": {"type": "string"}}, "produces": {"type": "array", "items": {"type": "string"}}, "context_hints": {"type": "object"}, "status": {"enum": ["PENDING", "ACTIVE", "COMPLETE", "BLOCKED", "SUPERSEDED"]}, "claim": {"type": ["object", "null"]}, "evidence": {"type": "array"}, "provenance": {"type": "array"}, "blocker": {"type": ["string", "object", "null"]}}, "additionalProperties": true}},
    "final_qa": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PENDING", "PASS", "FAIL"]}, "graph_revision": {"type": ["integer", "null"]}, "graph_digest": {"type": ["string", "null"]}, "workspace_fingerprint": {"type": ["string", "null"]}, "evidence": {"type": ["string", "object", "null"]}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
